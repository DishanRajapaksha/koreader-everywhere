#!/bin/sh
set -eu

AUTH_MODE="${VNC_AUTH:-password}"
PASSWORD_FILE="${VNC_PASSWORD_FILE:-/config/vnc.passwd}"
GEOMETRY="${EMULATE_READER_W:-600}x${EMULATE_READER_H:-800}"

case "$AUTH_MODE" in
    password)
        if [ -n "${VNC_PASSWORD:-}" ]; then
            umask 077
            mkdir -p "$(dirname "$PASSWORD_FILE")"
            printf '%s\n' "$VNC_PASSWORD" | tigervncpasswd -f > "$PASSWORD_FILE"
        fi

        if [ ! -r "$PASSWORD_FILE" ]; then
            echo >&2 "VNC authentication is enabled but no password is configured."
            echo >&2 "Set VNC_PASSWORD or mount a TigerVNC password file at $PASSWORD_FILE."
            exit 1
        fi

        exec Xtigervnc :0 \
            -geometry "$GEOMETRY" \
            -depth 24 \
            -rfbport 5900 \
            -localhost \
            -AlwaysShared \
            -AcceptSetDesktopSize \
            -SecurityTypes VncAuth \
            -rfbauth "$PASSWORD_FILE"
        ;;
    none)
        echo >&2 "WARNING: VNC_AUTH=none disables VNC authentication. Only use it behind a trusted authentication layer."
        exec Xtigervnc :0 \
            -geometry "$GEOMETRY" \
            -depth 24 \
            -rfbport 5900 \
            -localhost \
            -AlwaysShared \
            -AcceptSetDesktopSize \
            -SecurityTypes None
        ;;
    *)
        echo >&2 "Unsupported VNC_AUTH value: $AUTH_MODE (expected 'password' or 'none')."
        exit 2
        ;;
esac
