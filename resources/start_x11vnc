#!/bin/sh
set -eu

AUTH_MODE="${VNC_AUTH:-password}"
PASSWORD_FILE="${VNC_PASSWORD_FILE:-/config/vnc.passwd}"

case "$AUTH_MODE" in
    password)
        if [ -n "${VNC_PASSWORD:-}" ]; then
            umask 077
            mkdir -p "$(dirname "$PASSWORD_FILE")"
            x11vnc -storepasswd "$VNC_PASSWORD" "$PASSWORD_FILE" >/dev/null
        fi

        if [ ! -r "$PASSWORD_FILE" ]; then
            echo >&2 "VNC authentication is enabled but no password is configured."
            echo >&2 "Set VNC_PASSWORD or mount a password file at $PASSWORD_FILE."
            exit 1
        fi

        exec x11vnc -rfbauth "$PASSWORD_FILE" -localhost -forever -noxdamage -shared ${CURSOR:-}
        ;;
    none)
        echo >&2 "WARNING: VNC_AUTH=none disables VNC authentication. Only use it behind a trusted authentication layer."
        exec x11vnc -nopw -localhost -forever -noxdamage -shared ${CURSOR:-}
        ;;
    *)
        echo >&2 "Unsupported VNC_AUTH value: $AUTH_MODE (expected 'password' or 'none')."
        exit 2
        ;;
esac
